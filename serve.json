{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/servicios", "destination": "/soluciones" },
    { "source": "/servicios/:path*", "destination": "/soluciones/:path*" },
    { "source": "/services", "destination": "/soluciones" },
    { "source": "/contact", "destination": "/contacto" },
    { "source": "/articulos/:slug*", "destination": "/blog/:slug*" }
  ],
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|png|webp|avif|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "**/*.@(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
