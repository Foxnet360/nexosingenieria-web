# Site Configuration
NEXT_PUBLIC_SITE_URL=https://nexosingenieria.com

# Google Analytics 4 (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Database Persistence (PostgreSQL on Railway)
# En Railway se inyecta automáticamente con ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# SMTP Configuration (cPanel Winkhosting)
# Configura estas variables en Railway (Dashboard > Variables)
SMTP_HOST=mail.nexosingenieria.com
SMTP_PORT=465
SMTP_USER=comercial@nexosingenieria.com
SMTP_PASS=tu-contrasena-cpanel
SMTP_FROM="Nexos Ingeniería <comercial@nexosingenieria.com>"
COMMERCIAL_EMAIL=comercial@nexosingenieria.com
